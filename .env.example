# Copy this file to .env and replace all placeholder credentials.
# Never commit .env, API tokens, user keys, device tokens, or .p8 files.

# Page and storage
PAGEWATCHER_URL=https://example.com/products/widget
PAGEWATCHER_DATABASE_PATH=pagewatcher.db

# Polling and HTTP limits
PAGEWATCHER_POLL_INTERVAL_SECONDS=300
PAGEWATCHER_REQUEST_TIMEOUT_SECONDS=20
PAGEWATCHER_MAX_RESPONSE_BYTES=2000000

# Content selection and materiality
PAGEWATCHER_INCLUDE_SELECTORS=main
PAGEWATCHER_IGNORE_SELECTORS=script,style,noscript,template,.timestamp
PAGEWATCHER_SIMILARITY_THRESHOLD=0.98
PAGEWATCHER_MINIMUM_CHANGED_CHARACTERS=20

# Choose exactly one notification provider: apns or pushover.
PAGEWATCHER_NOTIFICATION_PROVIDER=pushover

# Pushover credentials. Replace these 30-character placeholder values.
PAGEWATCHER_PUSHOVER_APP_TOKEN=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
PAGEWATCHER_PUSHOVER_USER_KEY=UUUUUUUUUUUUUUUUUUUUUUUUUUUUUU
# Optional. Remove or leave empty to notify every device on the account.
PAGEWATCHER_PUSHOVER_DEVICE=

# To use APNs instead, change PAGEWATCHER_NOTIFICATION_PROVIDER to apns and
# uncomment this block. APNs variables are ignored when Pushover is selected.
# PAGEWATCHER_APNS_TEAM_ID=YOUR_TEAM_ID
# PAGEWATCHER_APNS_KEY_ID=YOUR_KEY_ID
# PAGEWATCHER_APNS_BUNDLE_ID=com.example.PagewatcherReceiver
# PAGEWATCHER_APNS_DEVICE_TOKEN=YOUR_DEVICE_TOKEN
# PAGEWATCHER_APNS_PRIVATE_KEY_PATH=/secure/path/AuthKey_EXAMPLE.p8
# PAGEWATCHER_APNS_USE_SANDBOX=true
